# Teacher API keys for TRAINING/distill  (copy to .env - never commit .env)
# Any number of keys per provider: PROVIDER_API, PROVIDER_API_1, PROVIDER_API_2, ... are all picked up
# automatically and used in order when the previous one hits its daily cap / budget.
# Two entries with the same value count as ONE account.
GEMINI_API=
GEMINI_API_2=
GROQ_API_1=
GROQ_API_2=
GROQ_API_3=
SARVAM_API_1=
SARVAM_API_2=
SARVAM_API_3=
OPENROUTER_API_1=
OPENROUTER_API_2=
OPENROUTER_API_3=

# Optional extra free tiers (see TRAINING/README.md - no card needed):
NVIDIA_API_1=        # https://build.nvidia.com  (40 req/min, no daily cap)
MISTRAL_API_1=       # https://console.mistral.ai  (1 req/s, 1B tokens/month)
CEREBRAS_API_1=      # https://cloud.cerebras.ai  (1M tokens/day, 8k-token requests)

# ── Backend (API / DB / Analytics) ──
POSTGRES_DSN=postgresql+psycopg://postgres:devpass@localhost:5432/oilens
DUCKDB_PATH=SERVER/ANALYTICS/oilens_analytics.duckdb
MODEL_DIR=SERVER/Classfication/Models
PIPELINE_VERSION=0.7.0
